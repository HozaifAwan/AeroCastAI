# Copy to .env for local use. Never commit real credentials.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=aerocastai@gmail.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=
